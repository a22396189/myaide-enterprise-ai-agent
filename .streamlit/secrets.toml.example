# 正式部署設定範本。
# 複製這個檔案為 .streamlit/secrets.toml 並填入正式的值，
# secrets.toml 已列在 .gitignore，不會被提交進版控。
#
# 用這個方式設定 API Key，一般使用者就完全不會在畫面上看到輸入框，
# 也不會有多人共用同一個伺服器行程、卻共用同一把手動輸入的 key 的風險。

GOOGLE_API_KEY = "your-gemini-api-key"

# 也可以在這裡設定品牌文案（優先權等同環境變數）：
# COMPANY_NAME = "您的公司名稱"
# APP_TITLE = "企業內部 AI 助理"
# APP_SUBTITLE = "您的一句話說明"
